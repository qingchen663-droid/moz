# ================================================================
# API 密钥
#   只存 API key，不存模型名和 URL。
#   选择哪个模型请在 model_config.py 中修改。
#   修改示例：
#     1. 在下方填入你的 API key
#     2. 在 model_config.py 中设置 CHAT_MODEL 和 CHAT_BASE_URL
#     3. 系统自动根据 base_url 识别提供商并匹配对应的 API key
#    必填api：
#     1.会话模型
#     2.向量嵌入模型
#    
# ================================================================

# 会话模型 API key（至少配置一个）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 当前向量嵌入服务固定使用智谱；语义记忆检索复用 ZHIPU_API_KEY。

# ================================================================
# 访问认证（可选，不配置则不需要认证）
# ================================================================

# 访问密钥 — 配置后前端需输入此密钥才能使用
# MOZ_ACCESS_KEY=your-secret-key

# 管理员密钥 — 用于访问日志、修改系统配置等敏感操作
# 如不配置但配置了 ACCESS_KEY，则 ACCESS_KEY 同时作为管理员密钥
# MOZ_ADMIN_KEY=your-admin-key

# 用户白名单；未配置时仅允许 web_user_001
# MOZ_ALLOWED_USER_IDS=web_user_001

# ================================================================
# CORS 跨域配置（可选）
#   默认允许 localhost:3000，多个源用逗号分隔
# ================================================================
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ================================================================
# 记忆巩固与容量治理（可选）
#   长期记忆达到触发线后自动执行：相似片段 LLM 巩固合并 → 低价值归档 → 过期归档清理
#   下面写的就是代码里的默认值，不配也是这个数。
#   注意：上限曾经是 300，会悄悄归档再物理删除用户历史，第四轮抬到 5000；
#   `MOZ_ARCHIVE_DELETE_AFTER=0` 表示归档永不物理删，别改回正数。
# ================================================================
# 触发自动维护的活跃记忆数量阈值
# MOZ_CONSOLIDATION_TRIGGER=3000
# 活跃记忆软上限（超过部分按程度分归档）
# MOZ_MAX_ACTIVE_MEMORIES=5000
# 归档保留多久（0 = 永不物理删除）
# MOZ_ARCHIVE_DELETE_AFTER=0

# ================================================================
# 检索性能（可选）
#   查询向量在进程内短时缓存，多个改写查询会合并为一次 Embedding 请求。
# ================================================================
# 查询向量缓存有效期（秒）和条目数上限
# MOZ_QUERY_EMBED_CACHE_TTL=60
# MOZ_QUERY_EMBED_CACHE_SIZE=128
# 关键词派生数据（分词/词频/剪枝用的 2 字连写集合）超过这个条数就不缓存
# MOZ_KEYWORD_INDEX_MAX_DOCS=20000

# ================================================================
# 响应时间（首字）— 完整口径、实测数字和被否掉的办法见 docs/响应时间账.md
# ================================================================
# 回话那一句带不带思考。默认 0 = 不带（中转对 MiMo 默认就在"先想后说"，
# 那几百字走 reasoning_content，用户一个字看不见，实测非敏感那句首字 16.6s → 4.4s）。
# 设成 1 恢复旧写法（更慢、回复更长）。改了要重启后端，正在跑的后端不会自己改。
# MOZ_CHAT_THINKING=0
# 命中敏感话题时，首字之前为情感分析那一次往返最多等几秒。0 = 完全不等。
# 这一项是用户点名要保留的，动之前先看 /api/metrics 的 emotion.sensitive_wait.payoff_rate
# MOZ_SENSITIVE_WAIT_SECONDS=45
# 向量服务失败后的退避：首次 120 秒，越退越长，封顶 1800 秒；成功一次立刻复位
# MOZ_EMBED_FAILURE_COOLDOWN=120
# MOZ_EMBED_FAILURE_COOLDOWN_MAX=1800
# 每小时 L2 情感预热允许几次模型调用（空烧额度时往下拧）
# MOZ_PREWARM_HOURLY_CAP=6
