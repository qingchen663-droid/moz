# 环境变量 & 密钥
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.pytest_cache/

# 虚拟环境
.venv/
.venv-python310/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 前端
frontend/dist/
frontend/node_modules/
frontend/tsconfig.app.tsbuildinfo
frontend/tsconfig.node.tsbuildinfo

# 本地数据（含用户隐私，不入版本控制）
backend/avatars/*
!backend/avatars/.gitkeep
backend/memory_store/*
!backend/memory_store/.gitkeep
backend/conversations/*
!backend/conversations/.gitkeep
backend/mem0_local_db/*
!backend/mem0_local_db/.gitkeep

# 自定义人设配置（含用户个性化 Prompt）
backend/prompt_config.json

# SQLite 数据库
*.db
*.db-shm
*.db-wal

# Streamlit 遗留配置
.streamlit/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 内部文档默认不入版本控制；架构文档单独保留
docs/*
!docs/MEMORY_FRAMEWORK.md

# 整夜自测期间新增：杂物与本地状态不入版本控制
frontend/node_modules-old/
.venv-empty/
.pytest_cache/
.ruff_cache/
*.log
*.tsbuildinfo
backend/moz.db-wal
backend/moz.db-shm

# 模型配置含真实 API Key，不入版本控制（本地仍在磁盘生效）
backend/runtime_model_config.json
